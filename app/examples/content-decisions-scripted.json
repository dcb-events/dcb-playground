{
  "$schema": "https://dcb.events/schemas/model/v6.json",
  "dcbModelVersion": "6.0",
  "name": "Content based decisions (scripted projection)",
  "customTypeDefinitions": [
    {
      "name": "DocumentStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Draft",
          "Published",
          "PendingChanges",
          "Archived"
        ]
      }
    },
    {
      "name": "DocumentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "DocumentChangeState",
      "properties": [
        {
          "name": "publishedText",
          "propertyType": "string"
        },
        {
          "name": "currentText",
          "propertyType": "string"
        },
        {
          "name": "status",
          "propertyType": "DocumentStatus"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "name": "DocumentAdded",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "TextUpdated",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "DocumentPublished",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "DocumentArchived",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Document",
      "icon": "📄",
      "properties": [
        {
          "name": "status",
          "projection": "DocumentStatus"
        }
      ]
    }
  ],
  "projectionDefinitions": [
    {
      "name": "DocumentStatus",
      "valueType": "DocumentStatus",
      "isList": false,
      "script": {
        "initialState": {
          "currentText": "",
          "publishedText": "",
          "status": "NonExistent"
        },
        "exposes": "status",
        "arguments": [
          {
            "name": "documentId",
            "propertyType": "DocumentId"
          }
        ],
        "tagFilter": [
          "DocumentId:{documentId}"
        ]
      },
      "handlers": [
        {
          "event": "DocumentAdded",
          "code": "{\"currentText\":\"\",\"publishedText\":\"\",\"status\":\"Draft\"}"
        },
        {
          "event": "TextUpdated",
          "code": "{\"currentText\":event.data.text,\"publishedText\":state.publishedText,\"status\":event.data.text == state.publishedText ? \"Published\" : \"PendingChanges\"}"
        },
        {
          "event": "DocumentPublished",
          "code": "{\"currentText\":state.currentText,\"publishedText\":state.currentText,\"status\":\"Published\"}"
        },
        {
          "event": "DocumentArchived",
          "code": "{\"currentText\":state.currentText,\"publishedText\":state.publishedText,\"status\":\"Archived\"}"
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "AddDocument",
      "feature": "Document Authoring",
      "icon": "⭐",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "id"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          }
        }
      ],
      "publishes": [
        {
          "name": "DocumentAdded",
          "parameters": {
            "id": {
              "parameterName": "id"
            }
          }
        }
      ]
    },
    {
      "name": "UpdateText",
      "feature": "Document Authoring",
      "icon": "✏️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          },
          "negate": true
        },
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Archived"
          },
          "negate": true
        }
      ],
      "publishes": [
        {
          "name": "TextUpdated",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "parameterName": "text"
            }
          }
        }
      ]
    },
    {
      "name": "PublishDocument",
      "feature": "Document Authoring",
      "icon": "💾",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "PendingChanges"
            }
          ]
        }
      ],
      "publishes": [
        {
          "name": "DocumentPublished",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveDocument",
      "feature": "Document Authoring",
      "icon": "🗑️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            },
            {
              "enumMember": "PendingChanges"
            }
          ]
        }
      ],
      "publishes": [
        {
          "name": "DocumentArchived",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            }
          }
        }
      ]
    }
  ],
