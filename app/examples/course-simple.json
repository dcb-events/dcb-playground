      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "capacity"
          }
        },
        {
          "event": "CourseCapacityChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newCapacity"
          }
        }
      ]
    },
    {
      "name": "CourseSubscriptionCount",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseSubscribedStudentIds",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "StudentId",
      "isList": true,
      "initialValue": [],
