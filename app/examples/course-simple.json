  "commandDefinitions": [
    {
      "name": "DefineCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          },
          "rejection": "Course already exists"
        }
      ],
      "publishes": [
        {
          "name": "CourseDefined",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "capacity": {
              "parameterName": "capacity"
            }
          }
        }
      ],
      "icon": "📚"
    },
    {
      "name": "ChangeCourseCapacity",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThanOrEquals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "rejection": "Course has more subscriptions than that"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "capacity"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "negate": true,
          "rejection": "Capacity is unchanged"
        }
      ],
      "publishes": [
        {
          "name": "CourseCapacityChanged",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "newCapacity": {
              "parameterName": "newCapacity"
            }
          }
        }
      ],
      "icon": "﹟"
    },
    {
