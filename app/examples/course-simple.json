          }
        },
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": {
            "alias": "course",
            "property": "capacity"
          },
          "rejection": "Course is full"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "negate": true,
          "rejection": "Student is already subscribed"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": 10,
          "rejection": "Student is subscribed to too many courses"
        }
      ],
      "publishes": [
        {
          "name": "StudentSubscribedToCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
