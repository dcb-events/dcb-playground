  "projectionDefinitions": [
    {
      "name": "StudentSubscriptionCount",
      "parameters": [
        {
          "name": "studentId",
          "propertyType": "StudentId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseStatus",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "CourseStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        },
        {
          "event": "CourseArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "CourseCapacity",
