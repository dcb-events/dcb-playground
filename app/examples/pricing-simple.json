{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Dynamic Product Price (simple)",
  "customTypeDefinitions": [
    {
      "name": "Money",
      "schema": {
        "type": "number",
        "minimum": 0
      }
    },
    {
      "name": "ProductId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "OrderId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "Item",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId"
        },
        {
          "name": "price",
          "propertyType": "Money"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "name": "ProductDefined",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "productId"
      ]
    },
    {
      "name": "ProductPriceChanged",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "productId"
      ]
    },
    {
      "name": "ProductsOrdered",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ],
      "tags": [
        "orderId",
        "items.productId"
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Product",
      "icon": "📦",
      "properties": [
        {
          "name": "exists",
          "projection": "ProductExists"
        },
        {
          "name": "currentPrice",
          "projection": "ProductCurrentPrice"
        }
      ],
      "lifecycle": "exists"
    },
    {
      "name": "Order",
      "icon": "🧾",
      "properties": [
        {
          "name": "exists",
          "projection": "OrderExists"
        }
      ],
      "lifecycle": "exists"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "ProductExists",
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "ProductCurrentPrice",
      "valueType": "Money",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": {
            "eventProperty": "price"
          }
        },
        {
          "event": "ProductPriceChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newPrice"
          }
        }
      ]
    },
    {
      "name": "OrderExists",
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "ProductsOrdered",
          "operation": "set",
          "value": true
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineProduct",
      "feature": "Catalogue",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "product",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Product already exists"
        }
      ],
      "publishes": [
        {
          "name": "ProductDefined",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "price": {
              "parameterName": "price"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeProductPrice",
      "feature": "Catalogue",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "product",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Product does not exist"
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "currentPrice"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "newPrice"
          },
          "negate": true,
          "rejection": "Price is unchanged"
        }
      ],
      "publishes": [
        {
          "name": "ProductPriceChanged",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "newPrice": {
              "parameterName": "newPrice"
            }
          }
        }
      ]
    },
    {
      "name": "OrderProducts",
      "feature": "Checkout",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ],
      "boundary": [
        {
          "alias": "order",
          "entity": "Order",
          "id": {
            "parameterName": "orderId"
          }
        },
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "items",
            "property": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "order",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Order was already placed"
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Product does not exist"
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "currentPrice"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "items",
            "property": "price"
          },
          "rejection": "Price has changed"
        }
      ],
      "publishes": [
        {
          "name": "ProductsOrdered",
          "parameters": {
            "orderId": {
              "parameterName": "orderId"
            },
            "items": {
              "parameterName": "items"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
