{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Dynamic Product Price (simple)",
  "customTypeDefinitions": [
    {
      "name": "Money",
      "schema": {
        "type": "number",
        "minimum": 0
      }
    },
    {
      "name": "ProductId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "OrderId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "Item",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId"
        },
        {
          "name": "price",
          "propertyType": "Money"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "name": "ProductDefined",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "productId"
      ]
    },
    {
      "name": "ProductPriceChanged",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "productId"
      ]
    },
    {
      "name": "ProductsOrdered",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ],
      "tags": [
        "orderId",
        "items.productId"
      ]
    }
  ],
  "entityDefinitions": [],
  "projectionDefinitions": [
    {
      "name": "ProductExists",
      "tags": [
        {
          "name": "productId",
          "tagType": "ProductId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "ProductCurrentPrice",
      "tags": [
        {
          "name": "productId",
          "tagType": "ProductId"
        }
      ],
      "valueType": "Money",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": {
            "eventProperty": "price"
          }
        },
        {
          "event": "ProductPriceChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newPrice"
          }
        }
      ]
    },
    {
      "name": "OrderExists",
      "tags": [
        {
          "name": "orderId",
          "tagType": "OrderId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "ProductsOrdered",
          "operation": "set",
          "value": true
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineProduct",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "ProductExists",
            "tags": {
              "productId": {
                "parameterName": "productId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Product already exists"
        }
      ],
      "publishes": [
        {
          "name": "ProductDefined",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "price": {
              "parameterName": "price"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeProductPrice",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "ProductExists",
            "tags": {
              "productId": {
                "parameterName": "productId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Product does not exist"
        },
        {
          "leftHandSide": {
            "projection": "ProductCurrentPrice",
            "tags": {
              "productId": {
                "parameterName": "productId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "newPrice"
          },
          "negate": true,
          "rejection": "Price is unchanged"
        }
      ],
      "publishes": [
        {
          "name": "ProductPriceChanged",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "newPrice": {
              "parameterName": "newPrice"
            }
          }
        }
      ]
    },
    {
      "name": "OrderProducts",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "OrderExists",
            "tags": {
              "orderId": {
                "parameterName": "orderId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Order was already placed"
        },
        {
          "leftHandSide": {
            "projection": "ProductExists",
            "tags": {
              "productId": {
                "each": {
                  "parameterName": "items",
                  "property": "productId"
                }
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Product does not exist"
        },
        {
          "leftHandSide": {
            "projection": "ProductCurrentPrice",
            "tags": {
              "productId": {
                "each": {
                  "parameterName": "items",
                  "property": "productId"
                }
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "items",
            "property": "price"
          },
          "rejection": "Price has changed"
        }
      ],
      "publishes": [
        {
          "name": "ProductsOrdered",
          "parameters": {
            "orderId": {
              "parameterName": "orderId"
            },
            "items": {
              "parameterName": "items"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
