{
  "$schema": "https://dcb.events/schemas/model/v7.json",
  "dcbModelVersion": "7.0",
  "name": "Course Example (with sequence)",
  "customTypeDefinitions": [
    {
      "name": "CourseStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent",
          "Archived"
        ]
      }
    },
    {
      "name": "StudentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseId",
      "schema": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      },
      "isTag": true
    }
  ],
  "eventDefinitions": [
    {
      "name": "CourseDefined",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "CourseCapacityChanged",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "CourseArchived",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "StudentRegistered",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "StudentSubscribedToCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "StudentUnsubscribedFromCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Student",
      "icon": "🧑‍🎓",
      "properties": [
        {
          "name": "exists",
          "projection": "StudentExists"
        },
        {
          "name": "subscriptionCount",
          "projection": "StudentSubscriptionCount"
        }
      ],
      "lifecycle": "exists"
    },
    {
      "name": "Course",
      "icon": "📚",
      "properties": [
        {
          "name": "status",
          "projection": "CourseStatus"
        },
        {
          "name": "capacity",
          "projection": "CourseCapacity"
        },
        {
          "name": "subscriptionCount",
          "projection": "CourseSubscriptionCount"
        },
        {
          "name": "subscribedStudentIds",
          "projection": "CourseSubscribedStudentIds"
        }
      ],
      "lifecycle": "status"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "StudentExists",
      "parameters": [
        {
          "name": "studentId",
          "propertyType": "StudentId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "StudentRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "StudentSubscriptionCount",
      "parameters": [
        {
          "name": "studentId",
          "propertyType": "StudentId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseStatus",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "CourseStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        },
        {
          "event": "CourseArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "CourseCapacity",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "capacity"
          }
        },
        {
          "event": "CourseCapacityChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newCapacity"
          }
        }
      ]
    },
    {
      "name": "CourseSubscriptionCount",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseSubscribedStudentIds",
      "parameters": [
        {
          "name": "courseId",
          "propertyType": "CourseId"
        }
      ],
      "valueType": "StudentId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "append",
          "value": {
            "eventProperty": "studentId"
          }
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "remove",
          "value": {
            "eventProperty": "studentId"
          }
        }
      ]
    },
    {
      "name": "CourseNumbering",
      "parameters": [],
      "valueType": "CourseId",
      "isList": false,
      "initialValue": "c1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseId"
            }
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "courseNumbering",
          "projection": "CourseNumbering",
          "arguments": {}
        }
      ],
      "conditions": [],
      "publishes": [
        {
          "name": "CourseDefined",
          "parameters": {
            "courseId": {
              "alias": "courseNumbering"
            },
            "capacity": {
              "parameterName": "capacity"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeCourseCapacity",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThanOrEquals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "rejection": "Course has more subscriptions than that"
        }
      ],
      "publishes": [
        {
          "name": "CourseCapacityChanged",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "newCapacity": {
              "parameterName": "newCapacity"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        }
      ],
      "publishes": [
        {
          "name": "CourseArchived",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterStudent",
      "feature": "Student registration",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Student is already registered"
        }
      ],
      "publishes": [
        {
          "name": "StudentRegistered",
          "parameters": {
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "SubscribeStudentToCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        },
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Student is not registered"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": {
            "alias": "course",
            "property": "capacity"
          },
          "rejection": "Course is full"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "negate": true,
          "rejection": "Student is already subscribed"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": 10,
          "rejection": "Student is subscribed to too many courses"
        }
      ],
      "publishes": [
        {
          "name": "StudentSubscribedToCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "UnsubscribeStudentFromCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "rejection": "Student is not subscribed"
        }
      ],
      "publishes": [
        {
          "name": "StudentUnsubscribedFromCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": [],
  "projectionScenarioDefinitions": [
    {
      "id": "a29c2e1f-6b04-4f5a-9d13-5f0a2d7c8e41",
      "name": "issues c1 before anything has happened",
      "projection": "CourseNumbering",
      "arguments": {},
      "given": [],
      "then": "c1"
    },
    {
      "id": "f47b9c30-2a8d-4e16-b5c7-9e3a1d604f28",
      "name": "issues c3 once two courses exist",
      "projection": "CourseNumbering",
      "arguments": {},
      "given": [
        {
          "event": "CourseDefined",
          "data": {
            "courseId": "c1",
            "capacity": 10
          }
        },
        {
          "event": "CourseDefined",
          "data": {
            "courseId": "c2",
            "capacity": 10
          }
        }
      ],
      "then": "c3"
    }
  ]
}
