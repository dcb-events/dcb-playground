{
  "$schema": "https://dcb.events/schemas/model/v6.json",
  "dcbModelVersion": "6.0",
  "name": "Content based decisions (guarded emissions)",
  "customTypeDefinitions": [
    {
      "name": "DocumentStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Draft",
          "Published",
          "PendingChanges",
          "Archived"
        ]
      }
    },
    {
      "name": "DocumentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    }
  ],
  "eventDefinitions": [
    {
      "name": "DocumentAdded",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "TextChanged",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "TextRevertedToPublished",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "DocumentPublished",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "DocumentArchived",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Document",
      "icon": "📄",
      "properties": [
        {
          "name": "status",
          "projection": "DocumentStatus"
        },
        {
          "name": "currentText",
          "projection": "DocumentCurrentText"
        },
        {
          "name": "publishedText",
          "projection": "DocumentPublishedText"
        }
      ]
    }
  ],
  "projectionDefinitions": [
    {
      "name": "DocumentStatus",
      "parameters": [
        {
          "name": "documentId",
          "propertyType": "DocumentId"
        }
      ],
      "valueType": "DocumentStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "DocumentAdded",
          "operation": "set",
          "value": {
            "enumMember": "Draft"
          }
        },
        {
          "event": "TextChanged",
          "operation": "set",
          "value": {
            "enumMember": "PendingChanges"
          }
        },
        {
          "event": "TextRevertedToPublished",
          "operation": "set",
          "value": {
            "enumMember": "Published"
          }
        },
        {
          "event": "DocumentPublished",
          "operation": "set",
          "value": {
            "enumMember": "Published"
          }
        },
        {
          "event": "DocumentArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "DocumentCurrentText",
      "parameters": [
        {
          "name": "documentId",
          "propertyType": "DocumentId"
        }
      ],
      "valueType": "string",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "DocumentAdded",
          "operation": "set",
          "value": ""
        },
        {
          "event": "TextChanged",
          "operation": "set",
          "value": {
            "eventProperty": "text"
          }
        },
        {
          "event": "TextRevertedToPublished",
          "operation": "set",
          "value": {
            "eventProperty": "text"
          }
        }
      ]
    },
    {
      "name": "DocumentPublishedText",
      "parameters": [
        {
          "name": "documentId",
          "propertyType": "DocumentId"
        }
      ],
      "valueType": "string",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "DocumentPublished",
          "operation": "set",
          "value": {
            "eventProperty": "text"
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "AddDocument",
      "feature": "Document Authoring",
      "icon": "⭐",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "id"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          }
        }
      ],
      "publishes": [
        {
          "name": "DocumentAdded",
          "parameters": {
            "id": {
              "parameterName": "id"
            }
          }
        }
      ]
    },
    {
      "name": "UpdateText",
      "feature": "Document Authoring",
      "icon": "✏️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            },
            {
              "enumMember": "PendingChanges"
            }
          ]
        },
        {
          "leftHandSide": {
            "alias": "document",
            "property": "currentText"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "text"
          },
          "negate": true
        }
      ],
      "publishes": [
        {
          "name": "TextChanged",
          "when": [
            {
              "leftHandSide": {
                "parameterName": "text"
              },
              "predicate": "equals",
              "rightHandSide": {
                "alias": "document",
                "property": "publishedText"
              },
              "negate": true
            }
          ],
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "parameterName": "text"
            }
          }
        },
        {
          "name": "TextRevertedToPublished",
          "when": [
            {
              "leftHandSide": {
                "parameterName": "text"
              },
              "predicate": "equals",
              "rightHandSide": {
                "alias": "document",
                "property": "publishedText"
              }
            }
          ],
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "parameterName": "text"
            }
          }
        }
      ]
    },
    {
      "name": "PublishDocument",
      "feature": "Document Authoring",
      "icon": "💾",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "PendingChanges"
            }
          ]
        }
      ],
      "publishes": [
        {
          "name": "DocumentPublished",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "alias": "document",
              "property": "currentText"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveDocument",
      "feature": "Document Authoring",
      "icon": "🗑️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            },
            {
              "enumMember": "PendingChanges"
            }
          ]
        }
      ],
      "publishes": [
        {
          "name": "DocumentArchived",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": [
    {
      "id": "d8a1be57-42f2-4d6f-aaff-e1fa6a574b9c",
      "name": "is refused while the document does not exist",
      "command": "UpdateText",
      "given": [],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "failedRule": {
          "index": 0,
          "text": "document.status equalsAny [Draft, Published, PendingChanges]",
          "leftValue": "NonExistent",
          "rightValue": [
            "Draft",
            "Published",
            "PendingChanges"
          ],
          "atInstance": null
        }
      }
    },
    {
      "id": "d94c3b59-6733-47ea-aa7d-80994348b497",
      "name": "records TextChanged while the text differs from the published one",
      "command": "UpdateText",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "TextChanged",
            "data": {
              "docId": "d1",
              "text": "test"
            }
          }
        ]
      }
    },
    {
      "id": "aed7a1d5-3c65-400e-aed0-f710781fb3fc",
      "name": "records TextRevertedToPublished when the published text is re-typed",
      "command": "UpdateText",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "TextRevertedToPublished",
            "data": {
              "docId": "d1",
              "text": "test"
            }
          }
        ]
      }
    },
    {
      "id": "5626525e-0182-4d5e-a4d8-86d4dde7cfa4",
      "name": "refuses to record an unchanged text",
      "command": "UpdateText",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "failedRule": {
          "index": 1,
          "text": "not(document.currentText == text)",
          "leftValue": "test",
          "rightValue": "test",
          "atInstance": null
        }
      }
    },
    {
      "id": "a9b1515d-f4ce-439e-aae5-61bd63bfd00c",
      "name": "publishes a fresh draft, carrying its empty text",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "DocumentPublished",
            "data": {
              "docId": "d1",
              "text": ""
            }
          }
        ]
      }
    },
    {
      "id": "2e1d8897-7098-4c3e-a505-2ee82fcb7999",
      "name": "refuses to republish an already published document",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "failedRule": {
          "index": 0,
          "text": "document.status equalsAny [Draft, PendingChanges]",
          "leftValue": "Published",
          "rightValue": [
            "Draft",
            "PendingChanges"
          ],
          "atInstance": null
        }
      }
    },
    {
      "id": "1f9a1001-f978-4845-af72-199e5aca96e9",
      "name": "refuses to publish after a recorded revert",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        },
        {
          "event": "TextRevertedToPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "failedRule": {
          "index": 0,
          "text": "document.status equalsAny [Draft, PendingChanges]",
          "leftValue": "Published",
          "rightValue": [
            "Draft",
            "PendingChanges"
          ],
          "atInstance": null
        }
      }
    },
    {
      "id": "ad730675-97ae-4132-a29a-1e873af5b837",
      "name": "cannot archive what does not exist",
      "command": "ArchiveDocument",
      "given": [],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "failedRule": {
          "index": 0,
          "text": "document.status equalsAny [Draft, Published, PendingChanges]",
          "leftValue": "NonExistent",
          "rightValue": [
            "Draft",
            "Published",
            "PendingChanges"
          ],
          "atInstance": null
        }
      }
    },
    {
      "id": "96a4524a-3052-4176-a3c6-f65ba8a791f3",
      "name": "archives a document with pending changes",
      "command": "ArchiveDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "DocumentArchived",
            "data": {
              "docId": "d1"
            }
          }
        ]
      }
    }
  ],
  "projectionScenarioDefinitions": [
    {
      "id": "c16bdc98-8e61-4b9e-a883-0ec5d6a05489",
      "name": "starts NonExistent",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [],
      "then": "NonExistent"
    },
    {
      "id": "ba6ed646-e5ae-44ec-afec-37fbbe25155b",
      "name": "is a Draft once added",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        }
      ],
      "then": "Draft"
    },
    {
      "id": "997bb9eb-eb55-4394-a63d-65efb6830e25",
      "name": "has PendingChanges once the text moved",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "then": "PendingChanges"
    },
    {
      "id": "72509d62-7224-4f9a-abfd-1fc5273d119f",
      "name": "is Published once published",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "then": "Published"
    },
    {
      "id": "6020ee84-d96e-4249-a07f-f1db72b06e47",
      "name": "has PendingChanges again after another change",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        }
      ],
      "then": "PendingChanges"
    },
    {
      "id": "4c987ff8-d6ab-499f-a43d-0467389266e0",
      "name": "is Published again after the recorded revert",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        },
        {
          "event": "TextRevertedToPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "then": "Published"
    },
    {
      "id": "e1219b4e-aa5d-4d73-a359-ca16a83d2907",
      "name": "is Archived at the end",
      "projection": "DocumentStatus",
      "arguments": {
        "documentId": "d1"
      },
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextChanged",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        },
        {
          "event": "TextRevertedToPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentArchived",
          "data": {
            "docId": "d1"
          }
        }
      ],
      "then": "Archived"
    }
  ]
}
