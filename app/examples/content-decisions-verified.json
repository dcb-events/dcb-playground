{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Content based decisions (client-verified)",
  "customTypeDefinitions": [
    {
      "name": "DocumentLifecycle",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Draft",
          "Published",
          "Archived"
        ]
      }
    },
    {
      "name": "DocumentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    }
  ],
  "eventDefinitions": [
    {
      "name": "DocumentAdded",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "id"
      ]
    },
    {
      "name": "TextUpdated",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "docId"
      ]
    },
    {
      "name": "DocumentPublished",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "docId"
      ]
    },
    {
      "name": "DocumentArchived",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "docId"
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Document",
      "icon": "📄",
      "properties": [
        {
          "name": "status",
          "projection": "DocumentLifecycle"
        },
        {
          "name": "currentText",
          "projection": "DocumentCurrentText"
        },
        {
          "name": "publishedText",
          "projection": "DocumentPublishedText"
        }
      ],
      "lifecycle": "status"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "DocumentLifecycle",
      "valueType": "DocumentLifecycle",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "DocumentAdded",
          "operation": "set",
          "value": {
            "enumMember": "Draft"
          }
        },
        {
          "event": "DocumentPublished",
          "operation": "set",
          "value": {
            "enumMember": "Published"
          }
        },
        {
          "event": "DocumentArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "DocumentCurrentText",
      "valueType": "string",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "DocumentAdded",
          "operation": "set",
          "value": ""
        },
        {
          "event": "TextUpdated",
          "operation": "set",
          "value": {
            "eventProperty": "text"
          }
        }
      ]
    },
    {
      "name": "DocumentPublishedText",
      "valueType": "string",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "DocumentPublished",
          "operation": "set",
          "value": {
            "eventProperty": "text"
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "AddDocument",
      "feature": "Document Authoring",
      "icon": "⭐",
      "properties": [
        {
          "name": "id",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "id"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          },
          "rejection": "Document already exists"
        }
      ],
      "publishes": [
        {
          "name": "DocumentAdded",
          "parameters": {
            "id": {
              "parameterName": "id"
            }
          }
        }
      ]
    },
    {
      "name": "UpdateText",
      "feature": "Document Authoring",
      "icon": "✏️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            }
          ],
          "rejection": "Document is not editable"
        },
        {
          "leftHandSide": {
            "alias": "document",
            "property": "currentText"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "text"
          },
          "negate": true,
          "rejection": "Text is unchanged"
        }
      ],
      "publishes": [
        {
          "name": "TextUpdated",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "parameterName": "text"
            }
          }
        }
      ]
    },
    {
      "name": "PublishDocument",
      "feature": "Document Authoring",
      "icon": "💾",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "text",
          "propertyType": "string",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            }
          ],
          "rejection": "Document cannot be published"
        },
        {
          "leftHandSide": {
            "alias": "document",
            "property": "currentText"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "text"
          },
          "rejection": "Text is not the current one"
        },
        {
          "leftHandSide": {
            "parameterName": "text"
          },
          "predicate": "equals",
          "rightHandSide": {
            "alias": "document",
            "property": "publishedText"
          },
          "negate": true,
          "rejection": "No changes to publish"
        }
      ],
      "publishes": [
        {
          "name": "DocumentPublished",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            },
            "text": {
              "parameterName": "text"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveDocument",
      "feature": "Document Authoring",
      "icon": "🗑️",
      "properties": [
        {
          "name": "docId",
          "propertyType": "DocumentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "document",
          "entity": "Document",
          "id": {
            "parameterName": "docId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "document",
            "property": "status"
          },
          "predicate": "equalsAny",
          "rightHandSide": [
            {
              "enumMember": "Draft"
            },
            {
              "enumMember": "Published"
            }
          ],
          "rejection": "Document cannot be archived"
        }
      ],
      "publishes": [
        {
          "name": "DocumentArchived",
          "parameters": {
            "docId": {
              "parameterName": "docId"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": [
    {
      "id": "8f05ccb9-3dd1-4d3e-a378-7057f445f0da",
      "name": "is refused while the document does not exist",
      "command": "UpdateText",
      "given": [],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "rejection": "Document is not editable"
      }
    },
    {
      "id": "f35f6dee-5ac9-499d-aefb-e09861f7e72a",
      "name": "publishes when the echoed text is the current one",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "DocumentPublished",
            "data": {
              "docId": "d1",
              "text": "test"
            }
          }
        ]
      }
    },
    {
      "id": "c078481e-b9a7-4e78-ab25-32da4cc86441",
      "name": "rejects a stale echo — the text moved since the caller looked",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "newer"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "rejection": "Text is not the current one"
      }
    },
    {
      "id": "29417195-82ca-4598-a1dc-18420e070bf5",
      "name": "refuses to republish while nothing differs",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "rejection": "No changes to publish"
      }
    },
    {
      "id": "f8fd554a-731a-4582-ade7-9381543e9bb8",
      "name": "refuses to publish after re-typing the published text",
      "command": "PublishDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test 2"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1",
          "text": "test"
        }
      },
      "then": {
        "outcome": "rejected",
        "events": [],
        "rejection": "No changes to publish"
      }
    },
    {
      "id": "c679e581-9f3f-4ab0-a409-c45e74b56d89",
      "name": "archives a published document",
      "command": "ArchiveDocument",
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "when": {
        "arguments": {
          "docId": "d1"
        }
      },
      "then": {
        "outcome": "published",
        "events": [
          {
            "type": "DocumentArchived",
            "data": {
              "docId": "d1"
            }
          }
        ]
      }
    }
  ],
  "projectionScenarioDefinitions": [
    {
      "id": "92754bc8-d112-4520-acf8-f8502a99a83a",
      "name": "holds the proven text after publishing",
      "projection": "DocumentPublishedText",
      "tags": [
        {
          "tagType": "DocumentId",
          "tagValue": "d1"
        }
      ],
      "given": [
        {
          "event": "DocumentAdded",
          "data": {
            "id": "d1"
          }
        },
        {
          "event": "TextUpdated",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        },
        {
          "event": "DocumentPublished",
          "data": {
            "docId": "d1",
            "text": "test"
          }
        }
      ],
      "then": "test"
    }
  ]
}
