{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Course Example (with sequence and tenant)",
  "customTypeDefinitions": [
    {
      "name": "CourseStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent",
          "Archived"
        ]
      }
    },
    {
      "name": "StudentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseId",
      "schema": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      },
      "isTag": true
    },
    {
      "name": "TenantId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseNumber",
      "schema": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    }
  ],
  "eventDefinitions": [
    {
      "name": "CourseDefined",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "courseNumber",
          "propertyType": "CourseNumber",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "tenantId",
        "courseId"
      ]
    },
    {
      "name": "CourseCapacityChanged",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "CourseArchived",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "StudentRegistered",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "studentId"
      ]
    },
    {
      "name": "StudentSubscribedToCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "StudentUnsubscribedFromCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "TenantRegistered",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "tenantId"
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Student",
      "icon": "🧑‍🎓",
      "properties": [
        {
          "name": "exists",
          "projection": "StudentExists"
        },
        {
          "name": "subscriptionCount",
          "projection": "StudentSubscriptionCount"
        }
      ],
      "lifecycle": "exists"
    },
    {
      "name": "Course",
      "icon": "📚",
      "properties": [
        {
          "name": "status",
          "projection": "CourseStatus"
        },
        {
          "name": "capacity",
          "projection": "CourseCapacity"
        },
        {
          "name": "subscriptionCount",
          "projection": "CourseSubscriptionCount"
        },
        {
          "name": "subscribedStudentIds",
          "projection": "CourseSubscribedStudentIds"
        }
      ],
      "lifecycle": "status"
    },
    {
      "name": "Tenant",
      "icon": "🏢",
      "properties": [
        {
          "name": "exists",
          "projection": "TenantExists"
        }
      ],
      "lifecycle": "exists"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "StudentExists",
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "StudentRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "StudentSubscriptionCount",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseStatus",
      "valueType": "CourseStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        },
        {
          "event": "CourseArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "CourseCapacity",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "capacity"
          }
        },
        {
          "event": "CourseCapacityChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newCapacity"
          }
        }
      ]
    },
    {
      "name": "CourseSubscriptionCount",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseSubscribedStudentIds",
      "valueType": "StudentId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "append",
          "value": {
            "eventProperty": "studentId"
          }
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "remove",
          "value": {
            "eventProperty": "studentId"
          }
        }
      ]
    },
    {
      "name": "CourseNumbering",
      "valueType": "CourseId",
      "isList": false,
      "initialValue": "c1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "TenantExists",
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "TenantRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "TenantCourseNumbering",
      "valueType": "CourseNumber",
      "isList": false,
      "initialValue": "1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseNumber"
            }
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "tenant",
          "entity": "Tenant",
          "id": {
            "parameterName": "tenantId"
          }
        },
        {
          "alias": "courseNumbering",
          "projection": "CourseNumbering",
          "tags": []
        },
        {
          "alias": "tenantCourseNumbering",
          "projection": "TenantCourseNumbering",
          "tags": [
            {
              "parameterName": "tenantId"
            }
          ]
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "tenant",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Tenant is not registered"
        }
      ],
      "publishes": [
        {
          "name": "CourseDefined",
          "parameters": {
            "courseId": {
              "alias": "courseNumbering"
            },
            "capacity": {
              "parameterName": "capacity"
            },
            "tenantId": {
              "parameterName": "tenantId"
            },
            "courseNumber": {
              "alias": "tenantCourseNumbering"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeCourseCapacity",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThanOrEquals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "rejection": "Course has more subscriptions than that"
        }
      ],
      "publishes": [
        {
          "name": "CourseCapacityChanged",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "newCapacity": {
              "parameterName": "newCapacity"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        }
      ],
      "publishes": [
        {
          "name": "CourseArchived",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterStudent",
      "feature": "Student registration",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Student is already registered"
        }
      ],
      "publishes": [
        {
          "name": "StudentRegistered",
          "parameters": {
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "SubscribeStudentToCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        },
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Student is not registered"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": {
            "alias": "course",
            "property": "capacity"
          },
          "rejection": "Course is full"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "negate": true,
          "rejection": "Student is already subscribed"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": 10,
          "rejection": "Student is subscribed to too many courses"
        }
      ],
      "publishes": [
        {
          "name": "StudentSubscribedToCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "UnsubscribeStudentFromCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "rejection": "Student is not subscribed"
        }
      ],
      "publishes": [
        {
          "name": "StudentUnsubscribedFromCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterTenant",
      "feature": "Tenancy",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "tenant",
          "entity": "Tenant",
          "id": {
            "parameterName": "tenantId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "tenant",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Tenant is already registered"
        }
      ],
      "publishes": [
        {
          "name": "TenantRegistered",
          "parameters": {
            "tenantId": {
              "parameterName": "tenantId"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
