{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Course Example (with sequence and tenant)",
  "customTypeDefinitions": [
    {
      "name": "CourseStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent",
          "Archived"
        ]
      }
    },
    {
      "name": "StudentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseId",
      "schema": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      },
      "isTag": true
    },
    {
      "name": "TenantId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseNumber",
      "schema": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    }
  ],
  "eventDefinitions": [
    {
      "name": "CourseDefined",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "courseNumber",
          "propertyType": "CourseNumber",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "tenantId",
        "courseId"
      ]
    },
    {
      "name": "CourseCapacityChanged",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "CourseArchived",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "StudentRegistered",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "studentId"
      ]
    },
    {
      "name": "StudentSubscribedToCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "StudentUnsubscribedFromCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "TenantRegistered",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "tenantId"
      ]
    }
  ],
  "entityDefinitions": [],
  "projectionDefinitions": [
    {
      "name": "StudentExists",
      "tags": [
        {
          "name": "studentId",
          "tagType": "StudentId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "StudentRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "StudentSubscriptionCount",
      "tags": [
        {
          "name": "studentId",
          "tagType": "StudentId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseStatus",
      "tags": [
        {
          "name": "courseId",
          "tagType": "CourseId"
        }
      ],
      "valueType": "CourseStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        },
        {
          "event": "CourseArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "CourseCapacity",
      "tags": [
        {
          "name": "courseId",
          "tagType": "CourseId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "capacity"
          }
        },
        {
          "event": "CourseCapacityChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newCapacity"
          }
        }
      ]
    },
    {
      "name": "CourseSubscriptionCount",
      "tags": [
        {
          "name": "courseId",
          "tagType": "CourseId"
        }
      ],
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseSubscribedStudentIds",
      "tags": [
        {
          "name": "courseId",
          "tagType": "CourseId"
        }
      ],
      "valueType": "StudentId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "append",
          "value": {
            "eventProperty": "studentId"
          }
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "remove",
          "value": {
            "eventProperty": "studentId"
          }
        }
      ]
    },
    {
      "name": "CourseNumbering",
      "tags": [],
      "valueType": "CourseId",
      "isList": false,
      "initialValue": "c1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "TenantExists",
      "tags": [
        {
          "name": "tenantId",
          "tagType": "TenantId"
        }
      ],
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "TenantRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "TenantCourseNumbering",
      "tags": [
        {
          "name": "tenantId",
          "tagType": "TenantId"
        }
      ],
      "valueType": "CourseNumber",
      "isList": false,
      "initialValue": "1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseNumber"
            }
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineCourse",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "courseNumbering",
          "projection": "CourseNumbering",
          "tags": {}
        },
        {
          "alias": "tenantCourseNumbering",
          "projection": "TenantCourseNumbering",
          "tags": {
            "tenantId": {
              "parameterName": "tenantId"
            }
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "TenantExists",
            "tags": {
              "tenantId": {
                "parameterName": "tenantId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Tenant is not registered"
        }
      ],
      "publishes": [
        {
          "name": "CourseDefined",
          "parameters": {
            "courseId": {
              "alias": "courseNumbering"
            },
            "capacity": {
              "parameterName": "capacity"
            },
            "tenantId": {
              "parameterName": "tenantId"
            },
            "courseNumber": {
              "alias": "tenantCourseNumbering"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeCourseCapacity",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CourseStatus",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "projection": "CourseSubscriptionCount",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "lessThanOrEquals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "rejection": "Course has more subscriptions than that"
        }
      ],
      "publishes": [
        {
          "name": "CourseCapacityChanged",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "newCapacity": {
              "parameterName": "newCapacity"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CourseStatus",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        }
      ],
      "publishes": [
        {
          "name": "CourseArchived",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterStudent",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "StudentExists",
            "tags": {
              "studentId": {
                "parameterName": "studentId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Student is already registered"
        }
      ],
      "publishes": [
        {
          "name": "StudentRegistered",
          "parameters": {
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "SubscribeStudentToCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CourseStatus",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "projection": "StudentExists",
            "tags": {
              "studentId": {
                "parameterName": "studentId"
              }
            }
          },
          "predicate": "isTrue",
          "rejection": "Student is not registered"
        },
        {
          "leftHandSide": {
            "projection": "CourseSubscriptionCount",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "lessThan",
          "rightHandSide": {
            "projection": "CourseCapacity",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "rejection": "Course is full"
        },
        {
          "leftHandSide": {
            "projection": "CourseSubscribedStudentIds",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "negate": true,
          "rejection": "Student is already subscribed"
        },
        {
          "leftHandSide": {
            "projection": "StudentSubscriptionCount",
            "tags": {
              "studentId": {
                "parameterName": "studentId"
              }
            }
          },
          "predicate": "lessThan",
          "rightHandSide": 10,
          "rejection": "Student is subscribed to too many courses"
        }
      ],
      "publishes": [
        {
          "name": "StudentSubscribedToCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "UnsubscribeStudentFromCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "CourseStatus",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "projection": "CourseSubscribedStudentIds",
            "tags": {
              "courseId": {
                "parameterName": "courseId"
              }
            }
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "rejection": "Student is not subscribed"
        }
      ],
      "publishes": [
        {
          "name": "StudentUnsubscribedFromCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterTenant",
      "properties": [
        {
          "name": "tenantId",
          "propertyType": "TenantId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [],
      "conditions": [
        {
          "leftHandSide": {
            "projection": "TenantExists",
            "tags": {
              "tenantId": {
                "parameterName": "tenantId"
              }
            }
          },
          "predicate": "isFalse",
          "rejection": "Tenant is already registered"
        }
      ],
      "publishes": [
        {
          "name": "TenantRegistered",
          "parameters": {
            "tenantId": {
              "parameterName": "tenantId"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
