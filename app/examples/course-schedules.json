{
  "$schema": "https://dcb.events/schemas/model/v8.json",
  "dcbModelVersion": "8.0",
  "name": "Course Example (with schedules)",
  "customTypeDefinitions": [
    {
      "name": "CourseStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent",
          "Archived"
        ]
      }
    },
    {
      "name": "StudentId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "CourseId",
      "schema": {
        "type": "string",
        "pattern": "^c[0-9]+$"
      },
      "isTag": true
    },
    {
      "name": "TimeSlot",
      "schema": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}$"
      }
    }
  ],
  "eventDefinitions": [
    {
      "name": "CourseDefined",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "slots",
          "propertyType": "TimeSlot",
          "isOptional": false,
          "isList": true
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "CourseCapacityChanged",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "CourseArchived",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId"
      ]
    },
    {
      "name": "StudentRegistered",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "studentId"
      ]
    },
    {
      "name": "StudentSubscribedToCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "StudentUnsubscribedFromCourse",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "tags": [
        "courseId",
        "studentId"
      ]
    },
    {
      "name": "CourseRescheduled",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "slots",
          "propertyType": "TimeSlot",
          "isOptional": false,
          "isList": true
        }
      ],
      "tags": [
        "courseId"
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Student",
      "icon": "🧑‍🎓",
      "properties": [
        {
          "name": "exists",
          "projection": "StudentExists"
        },
        {
          "name": "subscriptionCount",
          "projection": "StudentSubscriptionCount"
        },
        {
          "name": "subscribedCourseIds",
          "projection": "StudentSubscribedCourseIds"
        }
      ],
      "lifecycle": "exists"
    },
    {
      "name": "Course",
      "icon": "📚",
      "properties": [
        {
          "name": "status",
          "projection": "CourseStatus"
        },
        {
          "name": "capacity",
          "projection": "CourseCapacity"
        },
        {
          "name": "subscriptionCount",
          "projection": "CourseSubscriptionCount"
        },
        {
          "name": "subscribedStudentIds",
          "projection": "CourseSubscribedStudentIds"
        },
        {
          "name": "slots",
          "projection": "CourseSlots"
        }
      ],
      "lifecycle": "status"
    }
  ],
  "projectionDefinitions": [
    {
      "name": "StudentExists",
      "valueType": "boolean",
      "isList": false,
      "initialValue": false,
      "handlers": [
        {
          "event": "StudentRegistered",
          "operation": "set",
          "value": true
        }
      ]
    },
    {
      "name": "StudentSubscriptionCount",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseStatus",
      "valueType": "CourseStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        },
        {
          "event": "CourseArchived",
          "operation": "set",
          "value": {
            "enumMember": "Archived"
          }
        }
      ]
    },
    {
      "name": "CourseCapacity",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "capacity"
          }
        },
        {
          "event": "CourseCapacityChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newCapacity"
          }
        }
      ]
    },
    {
      "name": "CourseSubscriptionCount",
      "valueType": "integer",
      "isList": false,
      "initialValue": 0,
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "increment",
          "value": 1
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "decrement",
          "value": 1
        }
      ]
    },
    {
      "name": "CourseSubscribedStudentIds",
      "valueType": "StudentId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "append",
          "value": {
            "eventProperty": "studentId"
          }
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "remove",
          "value": {
            "eventProperty": "studentId"
          }
        }
      ]
    },
    {
      "name": "CourseNumbering",
      "valueType": "CourseId",
      "isList": false,
      "initialValue": "c1",
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "successor": {
              "eventProperty": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "CourseSlots",
      "valueType": "TimeSlot",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "CourseDefined",
          "operation": "set",
          "value": {
            "eventProperty": "slots"
          }
        },
        {
          "event": "CourseRescheduled",
          "operation": "set",
          "value": {
            "eventProperty": "slots"
          }
        }
      ]
    },
    {
      "name": "StudentSubscribedCourseIds",
      "valueType": "CourseId",
      "isList": true,
      "initialValue": [],
      "handlers": [
        {
          "event": "StudentSubscribedToCourse",
          "operation": "append",
          "value": {
            "eventProperty": "courseId"
          }
        },
        {
          "event": "StudentUnsubscribedFromCourse",
          "operation": "remove",
          "value": {
            "eventProperty": "courseId"
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "capacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "slots",
          "propertyType": "TimeSlot",
          "isOptional": false,
          "isList": true
        }
      ],
      "boundary": [
        {
          "alias": "courseNumbering",
          "projection": "CourseNumbering",
          "tags": []
        }
      ],
      "conditions": [],
      "publishes": [
        {
          "name": "CourseDefined",
          "parameters": {
            "courseId": {
              "alias": "courseNumbering"
            },
            "capacity": {
              "parameterName": "capacity"
            },
            "slots": {
              "parameterName": "slots"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeCourseCapacity",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newCapacity",
          "propertyType": "integer",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThanOrEquals",
          "rightHandSide": {
            "parameterName": "newCapacity"
          },
          "rejection": "Course has more subscriptions than that"
        }
      ],
      "publishes": [
        {
          "name": "CourseCapacityChanged",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "newCapacity": {
              "parameterName": "newCapacity"
            }
          }
        }
      ]
    },
    {
      "name": "ArchiveCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        }
      ],
      "publishes": [
        {
          "name": "CourseArchived",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            }
          }
        }
      ]
    },
    {
      "name": "RegisterStudent",
      "feature": "Student registration",
      "properties": [
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isFalse",
          "rejection": "Student is already registered"
        }
      ],
      "publishes": [
        {
          "name": "StudentRegistered",
          "parameters": {
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "SubscribeStudentToCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        },
        {
          "alias": "student",
          "entity": "Student",
          "id": {
            "parameterName": "studentId"
          }
        },
        {
          "alias": "others",
          "entity": "Course",
          "id": {
            "alias": "student",
            "property": "subscribedCourseIds"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "exists"
          },
          "predicate": "isTrue",
          "rejection": "Student is not registered"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": {
            "alias": "course",
            "property": "capacity"
          },
          "rejection": "Course is full"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "negate": true,
          "rejection": "Student is already subscribed"
        },
        {
          "leftHandSide": {
            "alias": "student",
            "property": "subscriptionCount"
          },
          "predicate": "lessThan",
          "rightHandSide": 10,
          "rejection": "Student is subscribed to too many courses"
        },
        {
          "leftHandSide": {
            "alias": "others",
            "property": "slots"
          },
          "predicate": "containsAny",
          "rightHandSide": {
            "alias": "course",
            "property": "slots"
          },
          "negate": true,
          "rejection": "Course clashes with the student's schedule"
        }
      ],
      "publishes": [
        {
          "name": "StudentSubscribedToCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "UnsubscribeStudentFromCourse",
      "feature": "Enrolment",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "studentId",
          "propertyType": "StudentId",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "course",
            "property": "subscribedStudentIds"
          },
          "predicate": "contains",
          "rightHandSide": {
            "parameterName": "studentId"
          },
          "rejection": "Student is not subscribed"
        }
      ],
      "publishes": [
        {
          "name": "StudentUnsubscribedFromCourse",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "studentId": {
              "parameterName": "studentId"
            }
          }
        }
      ]
    },
    {
      "name": "RescheduleCourse",
      "feature": "Course management",
      "properties": [
        {
          "name": "courseId",
          "propertyType": "CourseId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "slots",
          "propertyType": "TimeSlot",
          "isOptional": false,
          "isList": true
        }
      ],
      "boundary": [
        {
          "alias": "course",
          "entity": "Course",
          "id": {
            "parameterName": "courseId"
          }
        },
        {
          "alias": "students",
          "entity": "Student",
          "id": {
            "alias": "course",
            "property": "subscribedStudentIds"
          }
        },
        {
          "alias": "theirs",
          "entity": "Course",
          "id": {
            "alias": "students",
            "property": "subscribedCourseIds"
          },
          "excluding": {
            "parameterName": "courseId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "course",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          },
          "rejection": "Course is not active"
        },
        {
          "leftHandSide": {
            "alias": "theirs",
            "property": "slots"
          },
          "predicate": "containsAny",
          "rightHandSide": {
            "parameterName": "slots"
          },
          "negate": true,
          "rejection": "Slots clash with a subscriber's other course"
        }
      ],
      "publishes": [
        {
          "name": "CourseRescheduled",
          "parameters": {
            "courseId": {
              "parameterName": "courseId"
            },
            "slots": {
              "parameterName": "slots"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
