{
  "$schema": "https://dcb.events/schemas/model/v2.json",
  "dcbModelVersion": "2.0",
  "name": "Dynamic Product Price (simple)",
  "customTypeDefinitions": [
    {
      "name": "Money",
      "schema": {
        "type": "number",
        "minimum": 0
      }
    },
    {
      "name": "ProductStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent"
        ]
      }
    },
    {
      "name": "OrderStatus",
      "schema": {
        "type": "string",
        "enum": [
          "NonExistent",
          "Existent"
        ]
      }
    },
    {
      "name": "ProductId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "OrderId",
      "schema": {
        "type": "string"
      },
      "isTag": true
    },
    {
      "name": "Item",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId"
        },
        {
          "name": "price",
          "propertyType": "Money"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "name": "ProductDefined",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "ProductPriceChanged",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ]
    },
    {
      "name": "ProductsOrdered",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ]
    }
  ],
  "entityDefinitions": [
    {
      "name": "Product",
      "icon": "📦",
      "properties": [
        {
          "name": "status",
          "projection": "ProductStatus"
        },
        {
          "name": "currentPrice",
          "projection": "ProductCurrentPrice"
        }
      ]
    },
    {
      "name": "Order",
      "icon": "🧾",
      "properties": [
        {
          "name": "status",
          "projection": "OrderStatus"
        }
      ]
    }
  ],
  "projectionDefinitions": [
    {
      "name": "ProductStatus",
      "parameters": [
        {
          "name": "productId",
          "propertyType": "ProductId"
        }
      ],
      "valueType": "ProductStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        }
      ]
    },
    {
      "name": "ProductCurrentPrice",
      "parameters": [
        {
          "name": "productId",
          "propertyType": "ProductId"
        }
      ],
      "valueType": "Money",
      "isList": false,
      "initialValue": null,
      "handlers": [
        {
          "event": "ProductDefined",
          "operation": "set",
          "value": {
            "eventProperty": "price"
          }
        },
        {
          "event": "ProductPriceChanged",
          "operation": "set",
          "value": {
            "eventProperty": "newPrice"
          }
        }
      ]
    },
    {
      "name": "OrderStatus",
      "parameters": [
        {
          "name": "orderId",
          "propertyType": "OrderId"
        }
      ],
      "valueType": "OrderStatus",
      "isList": false,
      "initialValue": {
        "enumMember": "NonExistent"
      },
      "handlers": [
        {
          "event": "ProductsOrdered",
          "operation": "set",
          "value": {
            "enumMember": "Existent"
          }
        }
      ]
    }
  ],
  "commandDefinitions": [
    {
      "name": "DefineProduct",
      "feature": "Catalogue",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "price",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "product",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          }
        }
      ],
      "publishes": [
        {
          "name": "ProductDefined",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "price": {
              "parameterName": "price"
            }
          }
        }
      ]
    },
    {
      "name": "ChangeProductPrice",
      "feature": "Catalogue",
      "properties": [
        {
          "name": "productId",
          "propertyType": "ProductId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "newPrice",
          "propertyType": "Money",
          "isOptional": false,
          "isList": false
        }
      ],
      "boundary": [
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "product",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          }
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "currentPrice"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "newPrice"
          },
          "negate": true
        }
      ],
      "publishes": [
        {
          "name": "ProductPriceChanged",
          "parameters": {
            "productId": {
              "parameterName": "productId"
            },
            "newPrice": {
              "parameterName": "newPrice"
            }
          }
        }
      ]
    },
    {
      "name": "OrderProducts",
      "feature": "Checkout",
      "properties": [
        {
          "name": "orderId",
          "propertyType": "OrderId",
          "isOptional": false,
          "isList": false
        },
        {
          "name": "items",
          "propertyType": "Item",
          "isOptional": false,
          "isList": true
        }
      ],
      "boundary": [
        {
          "alias": "order",
          "entity": "Order",
          "id": {
            "parameterName": "orderId"
          }
        },
        {
          "alias": "product",
          "entity": "Product",
          "id": {
            "parameterName": "items",
            "property": "productId"
          }
        }
      ],
      "conditions": [
        {
          "leftHandSide": {
            "alias": "order",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "NonExistent"
          }
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "status"
          },
          "predicate": "equals",
          "rightHandSide": {
            "enumMember": "Existent"
          }
        },
        {
          "leftHandSide": {
            "alias": "product",
            "property": "currentPrice"
          },
          "predicate": "equals",
          "rightHandSide": {
            "parameterName": "items",
            "property": "price"
          }
        }
      ],
      "publishes": [
        {
          "name": "ProductsOrdered",
          "parameters": {
            "orderId": {
              "parameterName": "orderId"
            },
            "items": {
              "parameterName": "items"
            }
          }
        }
      ]
    }
  ],
  "scenarioDefinitions": []
}
