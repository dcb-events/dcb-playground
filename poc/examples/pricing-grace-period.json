            }
          }
        ],
        "conditions": [
          {
            "leftHandSide": {
              "alias": "product",
              "property": "status"
            },
            "predicate": "equals",
            "rightHandSide": {
              "enumMember": "NonExistent"
            }
          }
        ],
        "publishes": [
          {
            "name": "ProductDefined",
            "parameters": {
              "productId": {
                "parameterName": "productId"
              },
              "price": {
                "parameterName": "price"
              }
            }
          }
        ]
      },
      {
        "name": "ChangeProductPrice",
        "feature": "Catalogue",
        "properties": [
          {
            "name": "productId",
            "propertyType": "ProductId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "newPrice",
            "propertyType": "Money",
            "isOptional": false,
            "isList": false
          }
        ],
        "boundary": [
          {
            "alias": "product",
            "entity": "Product",
            "id": {
              "parameterName": "productId"
            }
          }
        ],
        "conditions": [
          {
            "leftHandSide": {
              "alias": "product",
              "property": "status"
            },
            "predicate": "equals",
            "rightHandSide": {
              "enumMember": "Existent"
            }
          },
          {
            "leftHandSide": {
              "alias": "product",
              "property": "currentPrice"
            },
            "predicate": "equals",
            "rightHandSide": {
              "parameterName": "newPrice"
            },
            "negate": true
          }
        ],
        "publishes": [
          {
            "name": "ProductPriceChanged",
            "parameters": {
              "productId": {
                "parameterName": "productId"
              },
              "newPrice": {
                "parameterName": "newPrice"
              }
            }
          }
        ]
      },
      {
        "name": "OrderProducts",
        "feature": "Checkout",
        "properties": [
          {
            "name": "orderId",
            "propertyType": "OrderId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "items",
            "propertyType": "Item",
            "isOptional": false,
            "isList": true
          },
          {
            "name": "now",
            "propertyType": "timestamp",
            "isOptional": false,
            "isList": false
          }
        ],
        "boundary": [
          {
            "alias": "order",
            "entity": "Order",
            "id": {
              "parameterName": "orderId"
            }
          },
          {
            "alias": "product",
            "entity": "Product",
            "id": {
              "parameterName": "items",
              "property": "productId"
            },
            "arguments": {
              "now": {
                "parameterName": "now"
              }
            }
          }
        ],
        "conditions": [
          {
            "leftHandSide": {
              "alias": "order",
              "property": "status"
            },
            "predicate": "equals",
            "rightHandSide": {
              "enumMember": "NonExistent"
            }
          },
          {
            "leftHandSide": {
              "alias": "product",
              "property": "status"
            },
            "predicate": "equals",
            "rightHandSide": {
              "enumMember": "Existent"
            }
          },
          {
            "leftHandSide": {
              "alias": "product",
              "property": "validPrices"
            },
            "predicate": "contains",
            "rightHandSide": {
              "parameterName": "items",
              "property": "price"
            }
          }
        ],
        "publishes": [
          {
            "name": "ProductsOrdered",
            "parameters": {
              "orderId": {
                "parameterName": "orderId"
              },
              "items": {
                "parameterName": "items"
              }
            }
          }
        ]
      }
    ],
    "scenarioDefinitions": []
  }
}
