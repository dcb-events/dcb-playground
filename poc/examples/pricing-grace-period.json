{
  "name": "Dynamic Product Price (with grace period)",
  "context": {
    "customTypeDefinitions": [
      {
        "name": "Money",
        "schema": {
          "type": "number",
          "minimum": 0
        }
      },
      {
        "name": "ProductStatus",
        "schema": {
          "type": "string",
          "enum": [
            "NonExistent",
            "Existent"
          ]
        }
      },
      {
        "name": "OrderStatus",
        "schema": {
          "type": "string",
          "enum": [
            "NonExistent",
            "Existent"
          ]
        }
      },
      {
        "name": "ProductId",
        "schema": {
          "type": "string"
        },
        "isTag": true
      },
      {
        "name": "OrderId",
        "schema": {
          "type": "string"
        },
        "isTag": true
      },
      {
        "name": "Item",
        "properties": [
          {
            "name": "productId",
            "propertyType": "ProductId"
          },
          {
            "name": "price",
            "propertyType": "Money"
          }
        ]
      }
    ],
    "eventDefinitions": [
      {
        "name": "ProductDefined",
        "properties": [
          {
            "name": "productId",
            "propertyType": "ProductId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "price",
            "propertyType": "Money",
            "isOptional": false,
            "isList": false
          }
        ]
      },
      {
        "name": "ProductPriceChanged",
        "properties": [
          {
            "name": "productId",
            "propertyType": "ProductId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "newPrice",
            "propertyType": "Money",
            "isOptional": false,
            "isList": false
          }
        ]
      },
      {
        "name": "ProductsOrdered",
        "properties": [
          {
            "name": "orderId",
            "propertyType": "OrderId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "items",
            "propertyType": "Item",
            "isOptional": false,
            "isList": true
          }
        ]
      }
    ],
    "entityDefinitions": [
      {
        "name": "Product",
        "icon": "📦",
        "properties": [
          {
            "name": "status",
            "propertyType": "ProductStatus",
            "isOptional": false,
            "isList": false,
            "initialValue": {
              "enumMember": "NonExistent"
            },
            "handlers": [
              {
                "event": "ProductDefined",
                "operation": "set",
                "value": {
                  "enumMember": "Existent"
                }
              }
            ]
          },
          {
            "name": "currentPrice",
            "propertyType": "Money",
            "isOptional": true,
            "isList": false,
            "initialValue": null,
            "handlers": [
              {
                "event": "ProductDefined",
                "operation": "set",
                "value": {
                  "eventProperty": "price"
                }
              },
              {
                "event": "ProductPriceChanged",
                "operation": "set",
                "value": {
                  "eventProperty": "newPrice"
                }
              }
            ]
          },
          {
            "name": "validPrices",
            "propertyType": "Money",
            "isList": true,
            "script": {
              "initialState": {
                "lastValidOldPrice": null,
                "validNewPrices": []
              },
              "exposes": "validNewPrices",
              "arguments": [
                {
                  "name": "now",
                  "propertyType": "timestamp"
                }
              ]
            },
            "handlers": [
              {
                "event": "ProductDefined",
                "code": "// A price set inside the window is valid, and so is the one that was\n// in force when the window opened — keep the latter until something\n// newer displaces it.\nevent.metadata.recordedAt >= args.now - 3600\n  ? {\n      lastValidOldPrice: state.lastValidOldPrice,\n      validNewPrices: [...state.validNewPrices, event.data.price],\n    }\n  : {\n      lastValidOldPrice: event.data.price,\n      validNewPrices: state.validNewPrices,\n    }"
              },
              {
                "event": "ProductPriceChanged",
                "code": "// A price set inside the window is valid, and so is the one that was\n// in force when the window opened — keep the latter until something\n// newer displaces it.\nevent.metadata.recordedAt >= args.now - 3600\n  ? {\n      lastValidOldPrice: state.lastValidOldPrice,\n      validNewPrices: [...state.validNewPrices, event.data.newPrice],\n    }\n  : {\n      lastValidOldPrice: event.data.newPrice,\n      validNewPrices: state.validNewPrices,\n    }"
              }
            ]
          }
        ]
      },
      {
        "name": "Order",
        "icon": "🧾",
        "properties": [
          {
            "name": "status",
            "propertyType": "OrderStatus",
            "isOptional": false,
            "isList": false,
            "initialValue": {
              "enumMember": "NonExistent"
            },
            "handlers": [
              {
                "event": "ProductsOrdered",
                "operation": "set",
                "value": {
                  "enumMember": "Existent"
                }
              }
            ]
          }
        ]
      }
    ],
    "projectionDefinitions": [],
    "commandDefinitions": [
      {
        "name": "DefineProduct",
        "feature": "Catalogue",
        "properties": [
          {
            "name": "productId",
            "propertyType": "ProductId",
            "isOptional": false,
            "isList": false
          },
          {
            "name": "price",
            "propertyType": "Money",
            "isOptional": false,
            "isList": false
          }
        ],
        "boundary": [
          {
            "alias": "product",
            "entity": "Product",
            "id": {
